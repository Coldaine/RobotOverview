# BEAST-01 Jetson Orin Nano staging defaults.
UGV_MODEL=ugv_beast
LDLIDAR_MODEL=ld19
UGV_SERIAL_PORT=/dev/ttyTHS1
UGV_WIFI_INTERFACE=wlP1p1s0
UGV_ETHERNET_INTERFACE=enP8p1s0

# The service keeps use_lidar=false. Replace this sentinel with the observed
# /dev/serial/by-id path before a supervised LiDAR session.
UGV_LIDAR_PORT=/dev/serial/by-id/SET_AFTER_DEVICE_DISCOVERY
