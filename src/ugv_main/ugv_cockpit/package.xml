<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_cockpit</name>
  <version>0.0.1</version>
  <description>
    BEAST-01 command spine. Owns the twist_mux arbitration layer that every velocity
    source must route through; twist_mux is the only publisher of /cmd_vel, which is
    the topic ugv_bringup subscribes to.
  </description>
  <maintainer email="pmaclyman@gmail.com">Coldaine</maintainer>
  <license>Apache-2.0</license>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
