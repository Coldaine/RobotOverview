# BEAST-01 Jetson Orin Nano staging defaults.
# Copy to /etc/beast/ugv.env (loaded by beast-ros-base.service).
UGV_MODEL=ugv_beast
LDLIDAR_MODEL=ld19
UGV_SERIAL_PORT=/dev/ttyTHS1
UGV_WIFI_INTERFACE=wlP1p1s0
UGV_ETHERNET_INTERFACE=enP8p1s0

# LD19 USB serial — stable by-id symlink (Wave 0 verified: serial …5970075705 → ttyACM1).
# beast-ros-base launches motion-enabled. ugv_safety_monitor disables motion when it
# observes an active Ethernet or charging interlock.
UGV_LIDAR_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_5970075705-if00-port0

# Optional LiDAR publish knobs (ldlidar.launch.py reads these; defaults match the fork).
# Driver masks the rear mast sector 225–315° (LiDAR degrees). Hangar SpatialView wedge
# is 45–134.5° in REP-103 body frame — reconcile live before trusting the UI wedge.
UGV_LIDAR_BINS=480
UGV_LIDAR_ENABLE_ANGLE_CROP=true
UGV_LIDAR_ANGLE_CROP_MIN=225.0
UGV_LIDAR_ANGLE_CROP_MAX=315.0
